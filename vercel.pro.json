{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:safe",
  "installCommand": "npm ci",
  "regions": ["fra1", "iad1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/trial-reminders", "schedule": "0 9 * * *" },
    { "path": "/api/cron/churn-reengagement", "schedule": "30 9 * * *" },
    { "path": "/api/cron/daily-missions-reset", "schedule": "0 0 * * *" },
    { "path": "/api/cron/weekly-analytics", "schedule": "0 6 * * 1" }
  ]
}